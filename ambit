#! /usr/bin/env bash

SCRIPTNAME="$0"

# Save the location of the of the script - it is where the Dockerfile
# resides.
SCRIPTDIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

CMANAGER=podman

IMAGENAME=ambit

ambit_usage () {
    cat <<EOF
Usage: $SCRIPTNAME [OPTION]... [PROJECT]...

Run Claude Code inside a container where it can only access the given project
directories. The container image with Claude Code and additional tooling will
be built automatically if it does not exist yet. Review, testing and source
control are assumed to happen outside of the container.

Options:

    -r, --rebuild   - rebuild the image before running, even if it already
                      exists

    -h, --help      - show this message

Examples:

    $SCRIPTNAME /path/to/project1 /path/to/project2

    $SCRIPTNAME --rebuild /path/to/project

EOF
}

ambit_build () {
    # Use `--no-cache` to make sure we always get the most recent
    # packages if rebuilding explicitly.
    $CMANAGER build --no-cache -t $IMAGENAME $SCRIPTDIR
}

ambit_run () {
    # Build the image if it does not exist.
    $CMANAGER images -q $IMAGENAME | grep -q . || ambit_build
    # Ensure the state/config directory exists.
    mkdir -p .claude
    # Build volume mounts and container name from all provided paths.
    local volumes=""
    for path in "$@"; do
        local host_path
        if ! host_path="$(realpath -e "$path" 2>/dev/null)" || [ ! -d "$host_path" ]; then
            echo "$SCRIPTNAME: not an existing directory: $path" >&2
            exit 1
        fi
        local container_path="$(basename "$host_path")"
        volumes="$volumes -v $host_path:/workspace/$container_path"
    done
    # Make a distinct container ID.
    local container_id="$(echo -n "$@" | sha256sum | cut -c1-8)"
    # Start the container with all project directories mounted into
    # `/workdir`.
    $CMANAGER run -it --rm \
           $volumes \
           -v "$(pwd)/.claude":/root/.claude \
           --name "ambit-$container_id" \
           $IMAGENAME
}

# Collect options and project paths, in any order.
rebuild=0
projects=()

while [ $# -gt 0 ]; do
    case "$1" in
        -h|--help)
            ambit_usage
            exit 0
            ;;
        -r|--rebuild)
            rebuild=1
            ;;
        -*)
            echo "$SCRIPTNAME: unknown option: $1" >&2
            ambit_usage >&2
            exit 1
            ;;
        *)
            projects+=("$1")
            ;;
    esac
    shift
done

if [ $rebuild -eq 1 ]; then
    ambit_build || exit 1
fi

ambit_run "${projects[@]}"
